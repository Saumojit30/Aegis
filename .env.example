# Aegis Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# System Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SEED=42

# Inference Topology (Decision D12: inprocess | http)
INFERENCE_MODE=inprocess
INFERENCE_SERVICE_URL=http://localhost:8001

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# MLflow Tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=aegis-t2d-forecast

# Database (PostgreSQL for containerized/production, SQLite fallback for dev)
DATABASE_URL=sqlite+aiosqlite:///./aegis_dev.db

# Replay Engine Settings (Decision D13)
REPLAY_PERSIST_ALL_OBSERVATIONS=false
REPLAY_TICK_SECONDS=1.0
